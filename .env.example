# Copy to .env locally. Keep the actual key out of source control and the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ALLOW_CHAT_FALLBACK=true
GEMINI_TIMEOUT_SECONDS=12
# auto: Supabase when configured, otherwise memory locally. Vercel always requires Supabase.
STORAGE_BACKEND=auto
SUPABASE_URL=
# Server-only sb_secret_... key. Never put this in frontend JavaScript.
SUPABASE_SECRET_KEY=
# A legacy service_role JWT can be used instead of the modern secret key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_SECONDS=8
# Accelerated, simulated timings measured from checkout start.
CHECKOUT_FAILURE_SECONDS=2
BANK_AUTHORISATION_SECONDS=35
PAYMENT_CAPTURE_SECONDS=37
ORDER_CONFIRMATION_SECONDS=38
ESCALATION_SECONDS=45
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=200
MAX_CHAT_MESSAGES=30
MAX_GEMINI_CONCURRENCY=4
SESSION_CREATES_PER_MINUTE=12
# Optional separate frontend during development; same-origin hosting needs no CORS.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
# Blank serves the bundled frontend automatically. Set an absolute path to override it.
FRONTEND_DIR=
