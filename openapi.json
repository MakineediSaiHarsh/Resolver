  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "text"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "$ref": "#/components/schemas/Message"
          },
          "session": {
            "$ref": "#/components/schemas/SessionView"
          },
          "chat_source": {
            "type": "string",
            "title": "Chat Source"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "session",
          "chat_source"
        ],
        "title": "ChatResponse"
      },
      "CheckoutRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "method": {
            "type": "string",
            "const": "upi",
            "title": "Method",
            "default": "upi"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "CheckoutRequest"
      },
      "ConsentRequest": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "allowed"
        ],
        "title": "ConsentRequest"
      },
      "CreateSession": {
        "properties": {
          "scenario": {
            "$ref": "#/components/schemas/Scenario",
            "default": "timeout_success"
          },
          "language": {
            "$ref": "#/components/schemas/Language",
            "default": "en"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateSession"
      },
      "Event": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "created_at"
        ],
        "title": "Event"
      },
      "EvidenceRequest": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "available"
        ],
        "title": "EvidenceRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Language": {
        "type": "string",
        "enum": [
          "en",
          "hi",
          "hinglish"
        ],
        "title": "Language"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "merchant",
              "user",
              "assistant",
              "system"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "text",
          "source",
          "created_at"
        ],
        "title": "Message"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "merchant": {
            "type": "string",
            "title": "Merchant",
            "default": "Thread & Loom"
          },
          "product": {
            "type": "string",
            "title": "Product",
            "default": "Everyday cotton shirt"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity",
            "default": 1
          },
          "amount_paise": {
            "type": "integer",
            "title": "Amount Paise",
            "default": 100000
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "INR"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "unpaid"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Order"
      },
      "PaymentAttempt": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "amount_paise": {
            "type": "integer",
            "title": "Amount Paise",
            "default": 100000
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "upi"
          },
          "error_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Reason"
          },
          "refund_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refund Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "title": "PaymentAttempt"
      },
      "Scenario": {
        "type": "string",
        "enum": [
          "timeout_success",
          "timeout_unresolved",
          "actionable_failure",
          "already_paid",
          "expired_order"
        ],
        "title": "Scenario"
      },
      "SessionCreated": {
        "properties": {
          "session_token": {
            "type": "string",
            "title": "Session Token"
          },
          "session": {
            "$ref": "#/components/schemas/SessionView"
          }
        },
        "type": "object",
        "required": [
          "session_token",
          "session"
        ],
        "title": "SessionCreated"
      },
      "SessionView": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "case_status": {
            "type": "string",
            "title": "Case Status"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "payments": {
            "items": {
              "$ref": "#/components/schemas/PaymentAttempt"
            },
            "type": "array",
            "title": "Payments"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          },
          "evidence_available": {
            "type": "boolean",
            "title": "Evidence Available"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Actions"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Events"
          },
          "last_message_id": {
            "type": "integer",
            "title": "Last Message Id"
          },
          "last_event_id": {
            "type": "integer",
            "title": "Last Event Id"
          },
          "receipt": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receipt"
          },
          "next_poll_ms": {
            "type": "integer",
            "title": "Next Poll Ms",
            "default": 1500
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": true
          },
          "timing": {
            "type": "string",
            "title": "Timing",
            "default": "accelerated_demo"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "scenario",
          "language",
          "phase",
          "case_status",
          "version",
          "order",
          "payments",
          "consent",
          "evidence_available",
          "allowed_actions",
          "messages",
          "events",
          "last_message_id",
          "last_event_id",
          "receipt"
        ],
        "title": "SessionView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Anonymous session token returned when a session is created.",
        "scheme": "bearer"
      }
    }
  }
}